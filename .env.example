# -----------------------------------------------------------------------------
# HirePilot - Environment Variables Template
# -----------------------------------------------------------------------------

# Frontend (Vite) Variables
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_WORKER_API_URL=http://localhost:8787/api
# Optional direct Gemini API key for standalone frontend development
VITE_GEMINI_API_KEY=

# Backend (Cloudflare Worker) Secrets
# Configure these in Cloudflare dashboard or .dev.vars for local wrangler
GEMINI_API_KEY=your-gemini-api-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
